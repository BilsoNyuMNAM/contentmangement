# Database Connection (Neon Postgres)
DATABASE_URL="postgresql://username:password@ep-xxxx.neon.tech/neondb?sslmode=require"

# Notion Session Token (from token_v2 cookie)
NOTION_TOKEN_V2="v03%3A..."

# Admin Passcode for /admin panel
ADMIN_SECRET="your-admin-password"

# Upstash Redis (Serverless Caching)
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AYix..."

# Server Port (optional, default: 3000, set automatically by Render/Railway)
PORT=3000
